<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Calendar.Client.ViewModels"
        xmlns:views="using:Calendar.Client.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
        x:Class="Calendar.Client.Views.MainWindow"
        x:DataType="vm:CalendarViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Calendar"
        Width="960" Height="680"
        MinWidth="720" MinHeight="520">

    <Design.DataContext>
        <vm:CalendarViewModel />
    </Design.DataContext>

    <views:CalendarView />

</Window>

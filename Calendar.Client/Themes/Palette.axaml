<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:themes="using:Calendar.Client.Themes">

    <!--
        Colour tokens, named by the role they play rather than by the colour they hold. A view
        asks for "the accent" and never for a hex value, which is what lets a theme replace the
        whole palette without any view being edited.

        Every theme defines the same complete set of names. Views look them up with
        DynamicResource, so switching the variant repaints the UI without reloading anything.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="{x:Static themes:AppThemes.BlueVariantKey}">
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="HoverBrush" Color="#F1F3F4" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#E4E7EB" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#DADCE0" />
            <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA3AD" />
            <SolidColorBrush x:Key="AccentBrush" Color="#1A73E8" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="{x:Static themes:AppThemes.GreenVariantKey}">
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlBrush" Color="#F6FAF7" />
            <SolidColorBrush x:Key="HoverBrush" Color="#EDF5EF" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#E1EBE4" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#D3E2D8" />
            <SolidColorBrush x:Key="TextBrush" Color="#1B2A1F" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#93A398" />
            <SolidColorBrush x:Key="AccentBrush" Color="#1E8E3E" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="{x:Static themes:AppThemes.VioletVariantKey}">
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ControlBrush" Color="#F9F7FC" />
            <SolidColorBrush x:Key="HoverBrush" Color="#F2EDFA" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#E8E4F0" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#DDD6EA" />
            <SolidColorBrush x:Key="TextBrush" Color="#241F2E" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9C93AD" />
            <SolidColorBrush x:Key="AccentBrush" Color="#6C40BF" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <!--
            The dark theme is what proves the token layer: it inverts surface and text without
            a single view knowing. Its accent is light, so the text sitting on the accent goes
            dark instead of white — which is exactly why AccentForegroundBrush exists as its
            own token rather than being assumed to be white.
        -->
        <ResourceDictionary x:Key="{x:Static themes:AppThemes.GraphiteVariantKey}">
            <SolidColorBrush x:Key="SurfaceBrush" Color="#202124" />
            <SolidColorBrush x:Key="ControlBrush" Color="#2A2D31" />
            <SolidColorBrush x:Key="HoverBrush" Color="#31353A" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#3C4043" />
            <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4E52" />
            <SolidColorBrush x:Key="TextBrush" Color="#E8EAED" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA0A6" />
            <SolidColorBrush x:Key="AccentBrush" Color="#8AB4F8" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#202124" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

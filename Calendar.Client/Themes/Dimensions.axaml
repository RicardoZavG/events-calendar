<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shape tokens: sizes, radii and spacing. Kept out of the palette because the layout does
        not change when the user picks another colour theme — only the colours do.

        Spacing follows a 4px grid, which is the density desktop UI is built on. A web scale
        such as Bootstrap's is anchored to 16px body text and reads far too loose here.
    -->

    <!-- Spacing scale, for Spacing properties (double) -->
    <x:Double x:Key="SpacingXs">2</x:Double>
    <x:Double x:Key="SpacingSm">4</x:Double>
    <x:Double x:Key="SpacingMd">8</x:Double>
    <x:Double x:Key="SpacingLg">12</x:Double>
    <x:Double x:Key="SpacingXl">16</x:Double>
    <x:Double x:Key="SpacingXxl">24</x:Double>

    <!-- The same scale as uniform Thickness, for Margin and Padding -->
    <Thickness x:Key="InsetXs">2</Thickness>
    <Thickness x:Key="InsetSm">4</Thickness>
    <Thickness x:Key="InsetMd">8</Thickness>
    <Thickness x:Key="InsetLg">12</Thickness>
    <Thickness x:Key="InsetXl">16</Thickness>

    <!--
        Type scale. Sizes are anchored to what the calendar already uses, so a heading level is
        chosen by meaning instead of by picking a number: the month title is an h2, the day
        numbers are body text, the weekday labels are captions.
    -->
    <x:Double x:Key="FontSizeH1">28</x:Double>
    <x:Double x:Key="FontSizeH2">22</x:Double>
    <x:Double x:Key="FontSizeH3">18</x:Double>
    <x:Double x:Key="FontSizeH4">16</x:Double>
    <x:Double x:Key="FontSizeH5">14</x:Double>
    <x:Double x:Key="FontSizeH6">13</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>

    <!-- Icon sizes, on the same sm/md/lg footing as the controls that hold them. -->
    <x:Double x:Key="IconSizeSm">14</x:Double>
    <x:Double x:Key="IconSizeMd">18</x:Double>
    <x:Double x:Key="IconSizeLg">24</x:Double>

    <!-- Control sizes. Md is the normal size; sm and lg are the variants around it. -->
    <x:Double x:Key="ControlHeightSm">28</x:Double>
    <x:Double x:Key="ControlHeightMd">34</x:Double>
    <x:Double x:Key="ControlHeightLg">42</x:Double>
    <Thickness x:Key="ControlPaddingSm">8,2</Thickness>
    <Thickness x:Key="ControlPaddingLg">16,8</Thickness>

    <!--
        Corner radii. RadiusPill is deliberately larger than any control: Avalonia clamps it to
        half the smaller side, so one token makes a control of any size fully rounded without
        having to keep a radius in sync with its height.
    -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Calendar-specific measurements that no general scale covers -->
    <x:Double x:Key="DayBadgeSize">26</x:Double>
    <!-- Wide enough for the longest month name, so the arrows beside it never shift. -->
    <x:Double x:Key="MonthTitleWidth">170</x:Double>
    <Thickness x:Key="HeaderMargin">16,12</Thickness>
    <Thickness x:Key="WeekdayLabelMargin">0,8</Thickness>
    <Thickness x:Key="DayCellPadding">6,4</Thickness>

    <!--
        Grid lines. Each cell draws its top and right edge only; the grid draws the remaining
        left and bottom edge, so adjacent cells never double their border.
    -->
    <Thickness x:Key="DayCellBorderThickness">0,1,1,0</Thickness>
    <Thickness x:Key="MonthGridBorderThickness">1,0,0,1</Thickness>

    <!--
        Vertical space reserved inside every day cell for the event chips of a later task, so
        adding real events will not reflow the grid.
    -->
    <x:Double x:Key="EventAreaMinHeight">48</x:Double>

</ResourceDictionary>

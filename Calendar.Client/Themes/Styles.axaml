<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">

    <!--
        The rules that turn the tokens in Dimensions.axaml and Palette.axaml into reusable
        appearances. A view states what an element *is* — a level-two heading, a small button —
        and never restates the numbers behind it.

        The normal size of every control carries no class. Only the variants around it do, so
        the common case stays unmarked and the exception is what reads.
    -->

    <!-- ===== Type scale ===== -->

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH3}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.h4">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH4}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.h5">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH5}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.h6">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH6}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Captions are secondary by nature, so they carry the muted colour by default. -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <!-- Modifier: demotes any text level to secondary without changing its size. -->
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <!-- ===== Pointer feedback ===== -->

    <!--
        Anything that responds to a click shows the hand cursor. Declared once by control type
        rather than per usage, so a new button gets the behaviour without anyone remembering.
        Deliberately not applied to the day cells: they do not react to a click yet, and a hand
        cursor over something inert promises an action that does not exist.
    -->
    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="DatePicker">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Rows of a list are chosen by clicking them, so they follow the same rule. -->
    <Style Selector="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- A disabled control is not clickable, so it keeps the ordinary arrow. -->
    <Style Selector="Button:disabled">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="ListBoxItem:disabled">
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- ===== Buttons ===== -->

    <!--
        The ordinary text button. Its colours are stated here rather than inherited from the
        theme default: a control left on the theme's own brushes is the one thing a palette
        swap cannot reach, and it has no guarantee of contrast against our surface.
    -->
    <Style Selector="Button.action">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMd}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPaddingSm}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.action /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
    </Style>

    <Style Selector="Button.action:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <!--
        Side panel entry: a full-width row that shows only its icon while the panel is
        collapsed, and gains its label when it opens. The selected one is marked with the
        accent so the current section is readable at a glance in either state.
    -->
    <Style Selector="Button.rail">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightLg}" />
        <!-- No padding: the icon column inside each entry does the aligning. -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.rail /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="Button.rail.selected">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.rail.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <!-- ===== Button size variants ===== -->

    <Style Selector="Button.sm">
        <Setter Property="Height" Value="{DynamicResource ControlHeightSm}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPaddingSm}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <Style Selector="Button.lg">
        <Setter Property="Height" Value="{DynamicResource ControlHeightLg}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPaddingLg}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH4}" />
    </Style>

    <!-- ===== Round icon buttons ===== -->

    <!--
        A square, fully rounded button holding a single glyph or icon. Combines with the size
        variants: Classes="round" is the normal size, Classes="round sm" the small one.
    -->
    <Style Selector="Button.round">
        <Setter Property="Width" Value="{DynamicResource ControlHeightMd}" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightMd}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeH4}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.round.sm">
        <Setter Property="Width" Value="{DynamicResource ControlHeightSm}" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightSm}" />
    </Style>

    <Style Selector="Button.round.lg">
        <Setter Property="Width" Value="{DynamicResource ControlHeightLg}" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightLg}" />
    </Style>

    <Style Selector="Button.round:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <!-- ===== Icons ===== -->

    <!--
        Icons are sized here and nowhere else. No Foreground is set on purpose: Foreground is
        an inherited property, so an icon takes the colour of whatever holds it and follows a
        theme change for free. Giving it a colour of its own would make every future theme
        special-case it.
    -->
    <Style Selector="materialIcons|MaterialIcon">
        <Setter Property="Width" Value="{DynamicResource IconSizeMd}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeMd}" />
    </Style>

    <Style Selector="materialIcons|MaterialIcon.sm">
        <Setter Property="Width" Value="{DynamicResource IconSizeSm}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeSm}" />
    </Style>

    <Style Selector="materialIcons|MaterialIcon.lg">
        <Setter Property="Width" Value="{DynamicResource IconSizeLg}" />
        <Setter Property="Height" Value="{DynamicResource IconSizeLg}" />
    </Style>

</Styles>

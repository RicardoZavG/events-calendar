<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Calendar.Client.App"
             xmlns:local="using:Calendar.Client"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:themes="using:Calendar.Client.Themes"
             RequestedThemeVariant="{x:Static themes:AppThemes.BlueVariantKey}">
             <!--
                 The starting variant is the default palette. It is replaced at startup by the
                 one stored in the user's settings; declaring it here means the designer and the
                 first frame always have a complete palette to resolve against.
             -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!--
        Design tokens, merged application-wide so every view resolves colours and dimensions by
        name instead of declaring its own.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Calendar.Client/Themes/Dimensions.axaml" />
                <ResourceInclude Source="avares://Calendar.Client/Themes/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- Included after FluentTheme so the project's own rules win over the theme defaults. -->
    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://Calendar.Client/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
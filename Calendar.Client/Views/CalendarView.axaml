<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="using:System"
             xmlns:vm="using:Calendar.Client.ViewModels"
             xmlns:models="using:Calendar.Client.Models"
             xmlns:res="using:Calendar.Client.Resources"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="Calendar.Client.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">

    <Design.DataContext>
        <vm:CalendarViewModel />
    </Design.DataContext>

    <!--
        No colour, size or text is written literally here. Shared appearances come from
        Themes/Styles.axaml, their values from the token dictionaries, and the text from
        Strings.resx. Only what is specific to the calendar is styled below.
    -->
    <UserControl.Styles>
        <!--
            Weekday header row. It sits on the filled band, so its colour comes from the band's
            own foreground token rather than from the caption class it would otherwise inherit:
            the ordinary muted text has no guarantee of contrast against a saturated colour.
        -->
        <Style Selector="TextBlock.weekday">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="{DynamicResource WeekdayLabelMargin}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource HeaderBandForegroundBrush}" />
        </Style>

        <!-- Day cells -->
        <Style Selector="Border.dayCell">
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource DayCellBorderThickness}" />
            <Setter Property="Padding" Value="{DynamicResource DayCellPadding}" />
            <!--
                Required, not decorative: a control with no background is invisible to the
                pointer, so without this the cell only reacted where one of its children
                happened to be and the hover appeared to come and go.
            -->
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.dayCell:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>

        <Style Selector="Border.dayBadge">
            <Setter Property="Width" Value="{DynamicResource DayBadgeSize}" />
            <Setter Property="Height" Value="{DynamicResource DayBadgeSize}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.dayBadge.today">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.dayNumber">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Event chips -->
        <Style Selector="Border.eventChip">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
            <Setter Property="Padding" Value="{DynamicResource EventChipPadding}" />
        </Style>
        <!-- A day the event merely runs through reads as an echo of where it started. -->
        <Style Selector="Border.eventChip.continuation">
            <Setter Property="Opacity" Value="0.65" />
        </Style>

        <Style Selector="Border.eventChip TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.eventTime">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.moreEvents">
            <Setter Property="Margin" Value="{DynamicResource InsetXs}" />
        </Style>

        <!-- Connection banner -->
        <Style Selector="Border.banner">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="{DynamicResource BannerPadding}" />
        </Style>
        <!-- Days borrowed from the neighbouring months read as secondary. -->
        <Style Selector="Border.dayCell.outside TextBlock.dayNumber">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <!-- Today's number sits inside the filled badge, so it inverts. -->
        <Style Selector="Border.dayBadge.today TextBlock.dayNumber">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource SurfaceBrush}">

        <!--
            Connection banner. Present only when something is wrong, and never in the way: the
            calendar below it stays navigable, because a month grid with no events is still
            more use than a window that refuses to open.
        -->
        <Border Grid.Row="0" Classes="banner" IsVisible="{Binding HasProblem}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingMd}"
                        VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="CloudOffOutline"
                                            VerticalAlignment="Center" />
                <TextBlock Classes="body" Text="{Binding ProblemMessage}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Classes="action sm"
                        Content="{x:Static res:Strings.ActionRetry}"
                        Command="{Binding ReloadCommand}"
                        IsEnabled="{Binding !IsLoading}" />
            </StackPanel>
        </Border>

        <!-- Header: navigation on the left, month title in the middle, jumps on the right -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="{DynamicResource HeaderMargin}">

            <!--
                The arrows flank the month name so the control and what it changes read as one
                unit. The month name is given a fixed width: without it, every step would
                resize the label and shift the arrows sideways.
            -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingMd}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Classes="round"
                        Command="{Binding PreviousMonthCommand}"
                        ToolTip.Tip="{x:Static res:Strings.TooltipPreviousMonth}">
                    <materialIcons:MaterialIcon Kind="ChevronLeft" />
                </Button>
                <TextBlock Classes="h2"
                           Width="{DynamicResource MonthTitleWidth}"
                           TextAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding MonthTitle}" />
                <Button Classes="round"
                        Command="{Binding NextMonthCommand}"
                        ToolTip.Tip="{x:Static res:Strings.TooltipNextMonth}">
                    <materialIcons:MaterialIcon Kind="ChevronRight" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        Spacing="{DynamicResource SpacingMd}"
                        VerticalAlignment="Center">
                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                            ToolTip.Tip="{x:Static res:Strings.TooltipJumpToDate}" />
                <Button Classes="action"
                        Content="{x:Static res:Strings.ActionToday}"
                        Command="{Binding GoToTodayCommand}"
                        ToolTip.Tip="{x:Static res:Strings.TooltipGoToToday}" />
            </StackPanel>
        </Grid>

        <!--
            Weekday header, carried on a filled band. The band is what gives the theme presence
            on screen: the accent occupies real surface instead of appearing only as a badge and
            a few lines.
        -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBandBrush}">
            <ItemsControl ItemsSource="{Binding WeekdayNames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <TextBlock Classes="caption weekday" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!--
            Day grid. Only the column count is fixed: with the 42 cells MonthGrid always
            produces, UniformGrid derives the six rows on its own.
        -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}"
                      BorderBrush="{DynamicResource GridLineBrush}"
                      BorderThickness="{DynamicResource MonthGridBorderThickness}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CalendarDay">
                    <Border Classes="dayCell" Classes.outside="{Binding !IsInCurrentMonth}">
                        <StackPanel Spacing="{DynamicResource SpacingSm}">
                            <Border Classes="dayBadge" Classes.today="{Binding IsToday}">
                                <TextBlock Classes="body dayNumber" Text="{Binding DayNumber}" />
                            </Border>
                            <!--
                                The space this panel claims was reserved from the first version
                                of the grid, so filling it does not change any row's height.
                            -->
                            <StackPanel Spacing="{DynamicResource SpacingXs}"
                                        MinHeight="{DynamicResource EventAreaMinHeight}">
                                <ItemsControl ItemsSource="{Binding VisibleEvents}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="{DynamicResource SpacingXs}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:EventChip">
                                            <Border Classes="eventChip"
                                                    Classes.continuation="{Binding IsContinuation}"
                                                    ToolTip.Tip="{Binding Title}">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{DynamicResource SpacingSm}">
                                                    <TextBlock Classes="eventTime"
                                                               Text="{Binding TimeLabel}"
                                                               IsVisible="{Binding TimeLabel,
                                                                   Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <TextBlock Classes="eventTitle"
                                                               Text="{Binding Title}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Classes="caption moreEvents"
                                           Text="{Binding HiddenEventsLabel}"
                                           IsVisible="{Binding HasHiddenEvents}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="using:System"
             xmlns:vm="using:Calendar.Client.ViewModels"
             xmlns:models="using:Calendar.Client.Models"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="Calendar.Client.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">

    <Design.DataContext>
        <vm:CalendarViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <!-- Design tokens: every colour used below comes from here, never inline. -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#E4E7EB" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA3AD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1A73E8" />
        <SolidColorBrush x:Key="HoverBrush" Color="#F1F3F4" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Header -->
        <Style Selector="TextBlock.monthTitle">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>

        <!-- Weekday header row -->
        <Style Selector="TextBlock.weekday">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <!-- Day cells -->
        <Style Selector="Border.dayCell">
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,1,0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="Border.dayCell:pointerover">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>

        <Style Selector="Border.dayBadge">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.dayBadge.today">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.dayNumber">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <!-- Days borrowed from the neighbouring months read as secondary. -->
        <Style Selector="Border.dayCell.outside TextBlock.dayNumber">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <!-- Today's number sits inside the filled badge, so it inverts. -->
        <Style Selector="Border.dayBadge.today TextBlock.dayNumber">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Background="{StaticResource SurfaceBrush}">

        <!-- Header: navigation on the left, month title in the middle, jumps on the right -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,12">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="nav" Content="&#x00AB;"
                        Command="{Binding PreviousYearCommand}"
                        ToolTip.Tip="Año anterior" />
                <Button Classes="nav" Content="&#x2039;"
                        Command="{Binding PreviousMonthCommand}"
                        ToolTip.Tip="Mes anterior" />
                <Button Classes="nav" Content="&#x203A;"
                        Command="{Binding NextMonthCommand}"
                        ToolTip.Tip="Mes siguiente" />
                <Button Classes="nav" Content="&#x00BB;"
                        Command="{Binding NextYearCommand}"
                        ToolTip.Tip="Año siguiente" />
            </StackPanel>

            <TextBlock Grid.Column="1" Classes="monthTitle"
                       HorizontalAlignment="Center"
                       Text="{Binding MonthTitle}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Hoy"
                        Command="{Binding GoToTodayCommand}"
                        ToolTip.Tip="Volver al mes actual" />
                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                            ToolTip.Tip="Ir a una fecha" />
            </StackPanel>
        </Grid>

        <!-- Weekday header -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekdayNames}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                    <TextBlock Classes="weekday" Text="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            Day grid. Only the column count is fixed: with the 42 cells MonthGrid always
            produces, UniformGrid derives the six rows on its own.
        -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}"
                      BorderBrush="{StaticResource GridLineBrush}"
                      BorderThickness="1,0,0,1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:CalendarDay">
                    <Border Classes="dayCell" Classes.outside="{Binding !IsInCurrentMonth}">
                        <StackPanel Spacing="4">
                            <Border Classes="dayBadge" Classes.today="{Binding IsToday}">
                                <TextBlock Classes="dayNumber" Text="{Binding DayNumber}" />
                            </Border>
                            <!--
                                Reserved for the event chips of a later task. The panel is
                                empty on purpose: it already claims the vertical space, so
                                adding real events will not reflow the grid.
                            -->
                            <StackPanel Spacing="2" MinHeight="48" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>

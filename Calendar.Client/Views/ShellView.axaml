<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Calendar.Client.ViewModels"
             xmlns:res="using:Calendar.Client.Resources"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="Calendar.Client.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <Design.DataContext>
        <vm:ShellViewModel />
    </Design.DataContext>

    <!--
        CompactOverlay keeps the icon rail visible at all times and floats the expanded panel
        over the content, so opening the menu never reflows the calendar underneath it.
    -->
    <SplitView DisplayMode="CompactOverlay"
               IsPaneOpen="{Binding IsPaneOpen}"
               CompactPaneLength="{DynamicResource RailWidth}"
               OpenPaneLength="{DynamicResource PaneWidth}"
               PaneBackground="{DynamicResource ControlBrush}">

        <SplitView.Pane>
            <!--
                Each entry puts its icon in a column exactly as wide as the collapsed rail, so
                the icon is centred while the panel is closed and stays on the same vertical
                line once it opens. The label is hidden rather than merely covered: at the rail
                width it would otherwise be clipped mid-word.
            -->
            <StackPanel>
                <Button Classes="rail"
                        Command="{Binding TogglePaneCommand}"
                        ToolTip.Tip="{x:Static res:Strings.TooltipToggleMenu}">
                    <Panel Width="{DynamicResource RailWidth}">
                        <materialIcons:MaterialIcon Kind="Menu" HorizontalAlignment="Center" />
                    </Panel>
                </Button>

                <Button Classes="rail"
                        Classes.selected="{Binding IsCalendarSelected}"
                        Command="{Binding ShowCalendarCommand}"
                        ToolTip.Tip="{x:Static res:Strings.SectionCalendar}">
                    <StackPanel Orientation="Horizontal">
                        <Panel Width="{DynamicResource RailWidth}">
                            <materialIcons:MaterialIcon Kind="CalendarMonth"
                                                        HorizontalAlignment="Center" />
                        </Panel>
                        <TextBlock Classes="body" Text="{x:Static res:Strings.SectionCalendar}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsPaneOpen}" />
                    </StackPanel>
                </Button>

                <Button Classes="rail"
                        Classes.selected="{Binding IsSettingsSelected}"
                        Command="{Binding ShowSettingsCommand}"
                        ToolTip.Tip="{x:Static res:Strings.SectionSettings}">
                    <StackPanel Orientation="Horizontal">
                        <Panel Width="{DynamicResource RailWidth}">
                            <materialIcons:MaterialIcon Kind="Cog"
                                                        HorizontalAlignment="Center" />
                        </Panel>
                        <TextBlock Classes="body" Text="{x:Static res:Strings.SectionSettings}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsPaneOpen}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </SplitView.Pane>

        <!-- The view for each section is resolved by the view locator from its view model. -->
        <ContentControl Content="{Binding CurrentSection}"
                        Background="{DynamicResource SurfaceBrush}" />
    </SplitView>
</UserControl>
